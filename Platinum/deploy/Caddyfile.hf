# Caddy reverse proxy for HuggingFace Spaces
# Single container: routes traffic to FastAPI and Odoo

:7860 {
    # FastAPI API routes
    handle /api/* {
        reverse_proxy localhost:8000
    }
    handle /health {
        reverse_proxy localhost:8000
    }
    handle /docs* {
        reverse_proxy localhost:8000
    }
    handle /openapi.json {
        reverse_proxy localhost:8000
    }
    handle /redoc* {
        reverse_proxy localhost:8000
    }

    # Odoo routes
    handle /web/* {
        reverse_proxy localhost:8069
    }
    handle /xmlrpc/* {
        reverse_proxy localhost:8069
    }
    handle /odoo/* {
        reverse_proxy localhost:8069
    }
    handle /website/* {
        reverse_proxy localhost:8069
    }
    handle /longpolling/* {
        reverse_proxy localhost:8072
    }

    # Default: send to FastAPI
    handle {
        reverse_proxy localhost:8000
    }

    log {
        output stdout
        format console
    }
}
