# Caddy reverse proxy configuration for AI Employee
# Provides HTTPS termination for API and Odoo
#
# Set DOMAIN env var or defaults to :80 (HTTP only, no HTTPS)
# Examples:
#   DOMAIN=your-domain.com  -> auto HTTPS via Let's Encrypt
#   DOMAIN=:80              -> HTTP only (dev/testing)

{$DOMAIN::80} {
    # API endpoints -> FastAPI on port 8000
    handle /health {
        reverse_proxy api:8000
    }

    handle /docs* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle /redoc* {
        reverse_proxy api:8000
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /dashboard {
        reverse_proxy api:8000
    }

    # Odoo web interface (everything else)
    handle /web/* {
        reverse_proxy odoo:8069
    }

    handle /website/* {
        reverse_proxy odoo:8069
    }

    handle /xmlrpc/* {
        reverse_proxy odoo:8069
    }

    handle /odoo/* {
        reverse_proxy odoo:8069
    }

    # Default: root goes to API info, /odoo for Odoo
    handle {
        reverse_proxy api:8000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# Internal health check endpoint for monitoring
:8080 {
    respond /health "OK" 200
}
